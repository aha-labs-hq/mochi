{
  "name": "mochi",
  "version": "0.3.4",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "verify": "bun run script/verify.ts",
    "start": "bun run src/index.ts",
    "app:prepare": "bun run script/prepare_desktop.ts",
    "app:build": "bun run script/build_desktop.ts",
    "app:start": "bun run script/build_desktop.ts --run",
    "app:dev": "bun run script/dev_desktop.ts",
    "quality:check": "biome check .",
    "quality:fix": "biome check --write .",
    "hooks:install": "lefthook install",
    "app:check": "bun run app:prepare && tsc --noEmit -p controlApp/tsconfig.json",
    "app:test": "bun test ./controlApp/tests",
    "app:test:ui": "bun run app:prepare && bun run script/test_desktop_ui.ts",
    "site:build": "bun run site/build/site.ts",
    "site:deploy": "bun run script/deploy_site.ts --registration",
    "site:deploy:public-beta": "bun run script/deploy_site.ts --public-beta",
    "site:deploy:release": "bun run script/deploy_site.ts --release",
    "site:serve": "bun run site/build/serve.ts",
    "site:motion": "bun run site/build/motion.ts",
    "site:check": "tsc --noEmit -p site/tsconfig.json",
    "runtime:build": "bun run script/build_pi_runtime.ts",
    "product:package": "bun run script/build_product_package.ts",
    "release:stage": "bun run script/stage_release_publication.ts",
    "release:upload": "bun run script/release_upload.ts",
    "release:update": "bun run script/release_update.ts",
    "release:readback": "bun run script/release_readback.ts",
    "runtime:command": "bun run src/maintenance/runtimeContract.ts",
    "runtime:provision": "bun run src/provisionRuntime.ts",
    "runtime:session:init": "bun run src/maintenance/initRuntimeSession.ts",
    "runtime:session:migrate": "bun run src/maintenance/migrateRuntimeSession.ts",
    "runtime:account:adopt": "bun run src/maintenance/adoptRuntimeAccount.ts",
    "service:install": "bun run src/maintenance/service.ts install",
    "service:deploy": "bun run script/deploy_development.ts",
    "service:restart": "bun run src/maintenance/service.ts restart",
    "service:status": "bun run src/maintenance/service.ts status",
    "service:uninstall": "bun run src/maintenance/service.ts uninstall",
    "doctor": "bun run src/maintenance/doctor.ts",
    "bot:list": "bun run src/index.ts bot:list",
    "governance:check": "bun run script/github_governance.ts check",
    "governance:audit": "bun run script/github_governance.ts audit",
    "governance:apply": "bun run script/github_governance.ts apply",
    "governance:retire-labels": "bun run script/github_governance.ts retire-labels",
    "github:identity:types": "wrangler types identity/worker-configuration.d.ts --config identity/wrangler.jsonc && wrangler types identity/maintainer-configuration.d.ts --env-interface MaintainerEnv --config identity/maintainer.wrangler.jsonc",
    "github:identity:check": "bun run github:identity:types && tsc --noEmit -p identity/tsconfig.json && bun test ./identity/test",
    "github:identity:deploy": "XDG_CONFIG_HOME=\"$HOME/.config/aha-labs\" wrangler deploy --config identity/wrangler.jsonc",
    "github:maintainer:deploy": "XDG_CONFIG_HOME=\"$HOME/.config/aha-labs\" wrangler deploy --config identity/maintainer.wrangler.jsonc",
    "github:commit": "bun run script/github_identity.ts commit",
    "github:propose": "bun run script/github_identity.ts propose",
    "github:merge": "bun run script/github_merge.ts",
    "check": "tsc --noEmit",
    "eval:agent": "bun run script/eval_agent.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.77",
    "@earendil-works/pi-agent-core": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "qrcode": "1.5.4",
    "typebox": "1.3.34"
  },
  "devDependencies": {
    "@base-ui/react": "1.8.0",
    "@biomejs/biome": "2.5.14",
    "@cloudflare/workers-types": "5.20260929.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electrobun": "2.0.1",
    "lefthook": "2.1.14",
    "motion": "13.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "wrangler": "4.143.0",
    "zustand": "5.0.15",
    "undici": "7.30.1"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@1.1.0": "patches/@earendil-works%2Fpi-ai@1.1.0.patch",
    "@earendil-works/pi-coding-agent@1.1.0": "patches/@earendil-works%2Fpi-coding-agent@1.1.0.patch",
    "node-forge@github:digitalbazaar/forge#7232404": "patches/node-forge@github%3Adigitalbazaar%2Fforge#7232404.patch",
    "@anthropic-ai/sandbox-runtime@0.0.77": "patches/@anthropic-ai%2Fsandbox-runtime@0.0.77.patch"
  },
  "overrides": {
    "typebox": "1.3.34",
    "minimatch": "11.0.1",
    "workerd": "1.20260929.1",
    "ws": "8.22.0",
    "esbuild": "0.28.2",
    "youch": "4.1.1",
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.30.1"
    },
    "node-forge": "git+https://github.com/digitalbazaar/forge.git#723240415b25120d47146f982809fa69344ab890",
    "undici": "8.12.2",
    "zod": "4.6.6"
  }
}
